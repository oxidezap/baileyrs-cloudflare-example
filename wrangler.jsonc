{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baileyrs-cloudflare-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Use baileyrs' host fallbacks instead of filesystem-based optional peer loading.
  "define": { "globalThis.process.getBuiltinModule": "undefined" },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [{ "name": "BOT", "class_name": "Bot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bot"] }]
}
